    family-names: Kharchenko
    affiliation: Axle Informatics
version: 0.11.0 # x-release-please-version
license: MIT
repository-code: "https://github.com/PolusAI/nyxus"
url: "https://nyxus.readthedocs.io"
keywords:
  - image analysis
  - feature extraction
  - radiomics
  - texture features
  - morphology
  - microscopy
  - medical imaging
